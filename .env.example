# Copy to .env and fill in values.
# Local Supabase: run `supabase status -o env` for API_URL and ANON_KEY.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: base URL for pass links shared to guests (no trailing slash).
# Web dev default: http://localhost:8081
EXPO_PUBLIC_PASS_LINK_BASE_URL=http://localhost:8081

# SMS (Twilio) — set on Supabase Edge Functions only, NOT in this Expo .env.
# See docs/SMS_DELIVERY.md
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+15551234567
