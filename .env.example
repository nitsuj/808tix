# Copy to .env and fill in values.
# Local Supabase: run `supabase status -o env` for API_URL and ANON_KEY.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL for ticket links shared to guests (absolute origin, no trailing slash).
# Protocol required for production; if omitted, https:// is prepended automatically.
# Production launch domain: https://808tickets.com
# Local web dev: http://localhost:8081 (or omit — falls back to window.location.origin on web)
# Also used as fallback for signup email confirmation redirects (see docs/MVP_ROADMAP.md).
# Native EAS builds: MUST use the public guest web origin (not the app scheme) so SMS/share links open the web ticket page.
# See docs/NATIVE_PHASE_0.md for EAS secret setup.
EXPO_PUBLIC_PASS_LINK_BASE_URL=https://808tickets.com

# SMS (Twilio) — set on Supabase Edge Functions only, NOT in this Expo .env.
# See docs/SMS_DELIVERY.md
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+15551234567
