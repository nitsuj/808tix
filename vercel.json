{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/events/:eventId",
      "destination": "/admin/events/[eventId].html"
    },
    {
      "source": "/design/admin-dashboard-prototype",
      "destination": "/design/admin-dashboard-prototype.html"
    },
    {
      "source": "/design/admin-event-detail-prototype",
      "destination": "/design/admin-event-detail-prototype.html"
    },
    {
      "source": "/design/admin-dashboard-review",
      "destination": "/design/admin-dashboard-review.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/home",
      "destination": "/home.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/explore",
      "destination": "/explore.html"
    },
    {
      "source": "/events/create",
      "destination": "/events/create.html"
    },
    {
      "source": "/events/:eventId/scan",
      "destination": "/events/[eventId]/scan.html"
    },
    {
      "source": "/events/:eventId/issue",
      "destination": "/events/[eventId]/issue.html"
    },
    {
      "source": "/events/:eventId/edit",
      "destination": "/events/[eventId]/edit.html"
    },
    {
      "source": "/events/:eventId/passes",
      "destination": "/events/[eventId]/passes.html"
    },
    {
      "source": "/events/:eventId/buy",
      "destination": "/events/[eventId]/buy.html"
    },
    {
      "source": "/events/:eventId",
      "destination": "/events/[eventId].html"
    },
    {
      "source": "/purchase/success",
      "destination": "/purchase/success.html"
    },
    {
      "source": "/purchase/cancel",
      "destination": "/purchase/cancel.html"
    },
    {
      "source": "/pass/:token",
      "destination": "/pass/[token].html"
    }
  ]
}
