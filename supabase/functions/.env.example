# Local Edge Function secrets for:
#   supabase functions serve send-pass-sms --env-file supabase/functions/.env
#
# Copy to supabase/functions/.env (gitignored). Do not commit real credentials.
# See docs/SMS_DELIVERY.md for Twilio setup and production deployment.

# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+18085550100

# Apple Wallet (wallet-apple Edge Function only — never in Expo .env)
# See docs/APPLE_WALLET_POC.md
# APPLE_PASS_TYPE_IDENTIFIER=pass.com.808tix.pass
# APPLE_TEAM_ID=
# APPLE_ORGANIZATION_NAME=808Tix
# APPLE_PASS_CERT_P12_BASE64=
# APPLE_PASS_CERT_PASSWORD=
# APPLE_WWDR_CERT_PEM=

# Stripe payments (create-checkout-session + stripe-webhook only — never in Expo .env)
# See docs/STRIPE_PAYMENTS.md
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Post-purchase email (stripe-webhook after fulfill_paid_order + manual send-order-confirmation-email)
# See docs/STRIPE_PAYMENTS.md — Email delivery
# PUBLIC_SITE_URL=http://localhost:8081
# RESEND_API_KEY=
# EMAIL_FROM=Tickets <tickets@your-verified-domain>
# EMAIL_DELIVERY_MODE=preview
# EMAIL_OVERRIDE_TO=you@yourdomain.com
#
# Real provider send smoke (isolated from Stripe):
#   EMAIL_SMOKE_ORDER_TOKEN=<paid-order-token> \
#   EMAIL_OVERRIDE_TO=you@yourdomain.com \
#   RESEND_API_KEY=re_... \
#   EMAIL_FROM='808Tickets <tickets@your-verified-domain.com>' \
#   PUBLIC_SITE_URL=http://localhost:8081 \
#   npm run smoke:email:send
# EMAIL_OVERRIDE_TO is required for smoke:email:send so the buyer is never emailed by accident.
# Use a fresh paid order token; prior order_confirmation rows block resend (idempotency).
